# Runtime environment: local | dev | uat | prod | test
VITE_APP_ENV="local"

# App Configuration
VITE_APP_TITLE="WMS Hoa Nam"
VITE_APP_VERSION="1.0.0"

# API Configuration
# Canonical rule: VITE_API_BASE_URL ends at /api/v1.
# Swagger local của BE: http://localhost:8080/api/documentation#/
# FE local gọi API qua: http://localhost:8080/api/v1/*
# DEV/UAT/PROD phải override bằng environment của pipeline/deployment.
VITE_API_BASE_URL="http://localhost:8080/api/v1"
VITE_API_HEALTH_PATH="/health"
VITE_API_TIMEOUT_MS=10000
# Bắt buộc để browser gửi HttpOnly refresh cookie sau F5. Access JWT vẫn chỉ
# nằm trong memory và tiếp tục gửi qua Authorization header.
VITE_API_WITH_CREDENTIALS=true

# RUM (Real User Monitoring) — tỉ lệ phiên được đo Web Vitals và bắn về
# POST /telemetry/vitals. 0 = tắt hẳn (không cài observer nào).
# Mặc định 0.1 khi bỏ trống. Prod nên để 0.1-0.2; local/dev thường để 0.
# LƯU Ý: số của RUM là người dùng THẬT, không được trộn với số của bàn đo
# (scripts/perf/bench) vốn chạy trên một máy với CPU bị bóp cố định.
VITE_RUM_SAMPLE_RATE=0

# Storage Configuration (optional). Empty value falls back to VITE_API_BASE_URL.
VITE_STORAGE_URL=""

# Realtime (Laravel Reverb) — giá trị KEY phải trùng REVERB_APP_KEY của BE (.env,
# do `php artisan reverb:install` sinh ra). Reverb local nghe cổng 6001 (8080 đã
# bị nginx chiếm), FE kết nối trực tiếp qua trình duyệt nên dùng cổng host, không
# phải hostname nội bộ docker network.
VITE_REVERB_APP_KEY=""
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME="http"

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
VITE_ENABLE_PERF_MONITOR=false

# TẠM THỜI — chế độ máy quét: lỗi hạ tầng tự thử lại ngầm, không dựng cửa sổ
# chặn "Không thể khôi phục phiên làm việc" và không hỏi cập nhật ứng dụng.
# Đặt lại false sau khi đợt quét kết thúc.
VITE_SCANNER_KIOSK_MODE=false

# TẠM THỜI cho quét/nghiệm thu local: tự đăng nhập qua backend bằng tài khoản
# SUPER_ADMIN. Chỉ bật ở local/dev/test; TUYỆT ĐỐI không bật khi deploy thật.
# VITE_TEMP_AUTO_LOGIN=false
# VITE_TEMP_AUTO_LOGIN_EMAIL="admin@gmail.com"
# VITE_TEMP_AUTO_LOGIN_PASSWORD=""
