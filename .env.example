# Runtime environment: local | dev | uat | prod | test
VITE_APP_ENV="local"

# App Configuration
VITE_APP_TITLE="WMS Hoa Nam"
VITE_APP_VERSION="1.0.0"

# API Configuration
# Local example: http://localhost:8000/api/v1
# DEV/UAT must point to an approved backend base URL and keep the /api/v1 prefix when required by BE.
VITE_API_BASE_URL="https://astrodev.test8.io.vn/api/v1"
VITE_API_HEALTH_PATH="/health"
VITE_API_TIMEOUT_MS=10000
# Set true only when backend CORS allows the exact frontend origin and auth uses cookies.
VITE_API_WITH_CREDENTIALS=false

# Storage Configuration (optional). Empty value falls back to VITE_API_BASE_URL.
VITE_STORAGE_URL=""

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false
VITE_ENABLE_PERF_MONITOR=false
